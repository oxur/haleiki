{% if site.data.breadcrumbs contains page.slug %}
{% assign crumbs = site.data.breadcrumbs[page.slug] %}
{% if crumbs.size > 0 %}
<nav class="breadcrumb" aria-label="Breadcrumb">
  {% for crumb in crumbs %}
    {% if forloop.last %}
      <span>{{ crumb.label }}</span>
    {% else %}
      <a href="{{ crumb.url }}">{{ crumb.label }}</a>
      <span class="sep">&#8250;</span>
    {% endif %}
  {% endfor %}
</nav>
{% endif %}
{% elsif page.data.category_slug %}
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/">Home</a><span class="sep">&#8250;</span>
  <a href="/browse/">Browse</a><span class="sep">&#8250;</span>
  <span>{{ page.title }}</span>
</nav>
{% elsif page.data.page_type == "browse" %}
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/">Home</a><span class="sep">&#8250;</span>
  <span>Browse</span>
</nav>
{% endif %}
