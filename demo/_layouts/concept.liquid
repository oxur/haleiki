<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page.data.concept }} — Haleiki Demo</title>
</head>
<body>
  <header>
    <nav>
      <a href="/">Haleiki Demo</a>
    </nav>
  </header>
  <main>
    <article class="concept-card">
      <header>
        <p class="overline">Concept</p>
        <h1>{{ page.data.concept }}{% if page.data.disambiguator %} <span class="disambiguator">({{ page.data.disambiguator }})</span>{% endif %}</h1>
        <p class="meta">{{ page.data.category }} · {{ page.data.tier }}</p>
      </header>
      <div class="content">
        {{ page.content }}
      </div>
    </article>
  </main>
  <footer>
    <p>Haleiki Demo Site</p>
  </footer>
</body>
</html>
