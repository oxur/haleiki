  "profile": {
    "name": "Haleiki Demo Wiki",
    "name_short": "Haleiki",
    "tagline": "A house of knowledge — a read-only wiki for structured, sourced content.",
    "hero_subtitle": "A knowledge base for encyclopedic exploration",
    "about_intro": "Haleiki is a read-only wiki for structured knowledge. The name means \"house of knowledge\" in Hawaiian. This page explains how we approach sourcing, evidence, and trust in the content you find here.",
    "about_body": [
      "Haleiki is a static-site knowledge base framework with a four-layer pipeline: authoring in Markdown, pre-build processing in Rust, template rendering with minijinja, and runtime as static HTML, CSS, and JavaScript. It supports structured content with typed relationships, concept extraction, and deployment profiles that adapt the same framework to different knowledge domains.",
      "This demo site showcases an encyclopedic deployment profile, drawing content from Wikipedia and Rigpa Wiki under Creative Commons licenses. For full source attribution, see the <a href=\"/attribution/\">Attribution</a> page.",
      "The Haleiki framework is open source, dual-licensed under Apache 2.0 and MIT. Source code and documentation are available on <a href=\"https://github.com/oxur/haleiki\">GitHub</a>."
    ],
    "content_notice": "Wiki content licensed under CC BY-SA 4.0, unless otherwise stated.",
    "trust": {
      "enabled": true,
      "default": "credible",
      "level_order": [
        "corroborated",
        "credible",
        "provisional",
        "speculative"
      ],
      "levels": {
        "corroborated": {
          "label": "Corroborated",
          "description": "Independently verified across multiple authoritative sources",
          "note": "No entries in this corpus are currently marked Corroborated."
        },
        "credible": {
          "label": "Credible",
          "description": "Well-sourced and represents a reasonable reading of available references",
          "note": "In this corpus, all entries are currently at the Credible level, reflecting well-sourced content drawn from established reference works."
        },
        "provisional": {
          "label": "Provisional",
          "description": "Based on partial or emerging evidence, subject to revision",
          "note": "No entries in this corpus are currently marked Provisional."
        },
        "speculative": {
          "label": "Speculative",
          "description": "Limited or fragmentary sourcing, included for completeness",
          "note": "No entries in this corpus are currently marked Speculative."
        }
      }
    },
