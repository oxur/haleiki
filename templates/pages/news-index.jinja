{% extends "base.jinja" %}
{% block active_nav %}news{% endblock %}
{% block title %}News — {{ site.data.profile.name_short | default("Haleiki") }}{% endblock %}
{% block body_class %}page-news{% endblock %}
{% block main %}
<main id="main-content" class="news-page">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">{{ site.data.profile.name_short | default("Haleiki") }}</a><span class="sep">&#8250;</span><span>News</span></nav>

  <header class="news-header">
    <div class="news-overline">News</div>
    <h1 class="news-title">What&rsquo;s New</h1>
    <p class="news-subtitle">Updates, announcements, and development notes from {{ site.data.profile.name_short | default("Haleiki") }}.</p>
    <a href="/news/feed.xml" class="news-rss">Subscribe via RSS &#8599;</a>
  </header>

  {% set posts = news.posts %}
  {% if posts | length > 0 %}
  {% set hero = posts[0] %}
  <article class="hero-card">
    <div class="post-date">{{ hero.date_display }}</div>
    <h2 class="post-title"><a href="{{ hero.url }}">{{ hero.title }}</a></h2>
    <span class="post-category">{{ hero.category }}</span>
    <p class="post-excerpt">{{ hero.excerpt }}</p>
    <a href="{{ hero.url }}" class="read-more">Read more &#8594;</a>
  </article>
  {% endif %}

  {% if posts | length > 1 %}
  <div class="secondary-grid">
    {% for post in posts[1:3] %}
    <article class="secondary-card">
      <div class="post-date">{{ post.date_display }}</div>
      <h2 class="post-title"><a href="{{ post.url }}">{{ post.title }}</a></h2>
      <span class="post-category">{{ post.category }}</span>
      <p class="post-excerpt">{{ post.excerpt }}</p>
      <a href="{{ post.url }}" class="read-more">Read more &#8594;</a>
    </article>
    {% endfor %}
  </div>
  {% endif %}

  {% if posts | length > 3 %}
  <section class="recent-section">
    <h2 class="section-heading section-heading--compact">Recent</h2>
    <ul class="compact-list">
      {% for post in posts[3:] %}
      <li class="compact-row">
        <span class="compact-date">{{ post.date_short }}</span>
        <span class="compact-title"><a href="{{ post.url }}">{{ post.title }}</a></span>
        <span class="compact-category">{{ post.category }}</span>
        <span class="compact-arrow">&#8594;</span>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <div class="view-all"><a href="/news/archive/">View all posts &#8594;</a></div>

  <div class="bottom-grid">
    <div class="bottom-card">
      <h3 class="bottom-card-title">Categories</h3>
      <ul class="category-list">
        {% for cat in news.categories %}<li><a href="/news/category/{{ cat.slug }}/">{{ cat.name }}</a><span class="category-count">({{ cat.count }})</span></li>{% endfor %}
      </ul>
    </div>
    <div class="bottom-card">
      <h3 class="bottom-card-title">Tags</h3>
      <div class="tag-cloud">
        {% for tag in news.tags %}<a href="/news/tag/{{ tag.slug }}/">{{ tag.name }}</a>{% endfor %}
      </div>
    </div>
  </div>
</main>
{% endblock %}
